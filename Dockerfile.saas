# UI v1 (ant-design-pro / Umi)
FROM reg.smvm.cn/appbase/node:22-alpine as js-builder

ENV NODE_OPTIONS=--max_old_space_size=8000
WORKDIR /clickvisual
COPY ui/package.json ui/yarn.lock ./

RUN yarn -v

ENV PUBLIC_PATH=/clickvisual/

RUN yarn install --frozen-lockfile --network-timeout 100000
ENV NODE_ENV production
COPY ui .
RUN yarn build


# UI v2 (Vite — Node 18+; plain Node image, no Puppeteer stack)
FROM reg.smvm.cn/appbase/node:22-alpine as js-builder-v2
WORKDIR /clickvisual

ENV PUBLIC_PATH=/clickvisual/

COPY ui-v2/package.json ui-v2/package-lock.json ./ui-v2/
RUN cd ui-v2 && npm ci

ENV NODE_ENV production
ENV VITE_ENABLE_V1_UI=true
COPY ui-v2 ./ui-v2
RUN cd ui-v2 && npm run build


# API build stage
FROM reg.smvm.cn/appbase/golang-build:1.24-alpine3.22 as go-builder
ARG GOPROXY=goproxy.cn

# Accept both a bare proxy host (for example, goproxy.cn) and a complete Go
# proxy value (for example, https://goproxy.cn,direct).
RUN set -eux; \
    proxy="${GOPROXY%,direct}"; \
    case "${proxy}" in \
      http://*|https://*|direct|off) ;; \
      *) proxy="https://${proxy}" ;; \
    esac; \
    case "${proxy}" in \
      direct|off|*,direct) ;; \
      *) proxy="${proxy},direct" ;; \
    esac; \
    go env -w GOPROXY="${proxy}"
# RUN sed -i 's/dl-cdn.alpinelinux.org/mirrors.aliyun.com/g' /etc/apk/repositories
RUN apk add --no-cache make bash tzdata

ARG TARGETOS TARGETARCH
WORKDIR /clickvisual

COPY go.mod go.sum ./
RUN go mod download -x
COPY . .
COPY --from=js-builder /clickvisual/dist ./api/internal/ui/dist
COPY --from=js-builder-v2 /clickvisual/api/internal/ui/v2dist/dist ./api/internal/ui/v2dist/dist
RUN ls -rlt ./api/internal/ui/dist ./api/internal/ui/v2dist/dist && CGO_ENABLED=0 GOOS=$TARGETOS GOARCH=$TARGETARCH make build.api


# Fianl running stage
FROM reg.smvm.cn/appbase/alpine:3.16.9 as final
LABEL maintainer="clickvisual@shimo.im"

WORKDIR /clickvisual

COPY --from=go-builder /clickvisual/bin/clickvisual ./bin/
COPY --from=go-builder /clickvisual/config ./config

EXPOSE 9001
EXPOSE 9003
# RUN sed -i 's/dl-cdn.alpinelinux.org/mirrors.aliyun.com/g' /etc/apk/repositories
RUN apk --update add --no-cache tzdata
RUN mkdir -p data logs && chmod 0777 data logs

CMD ["sh", "-c", "./bin/clickvisual server"]
